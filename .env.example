# Use "production" on server → loads config/production.toml
APP_ENV=local

DATABASE_URL=sqlite://./data/auth.db
PUBLIC_BASE_URL=http://localhost:3324
# Development only: also permits HTTP CIMD URLs that resolve to private addresses.
CIMD_ALLOW_PRIVATE_ADDRESSES=false

# Must match your MCP server's INTERNAL_API_KEY.
INTERNAL_API_KEY=change-me-in-production

# Docker: arcgis-mcp-oauth creates the shared "arcgis-mcp" network. Start arcgis-mcp-oauth before
# your MCP server so it can reach this service at http://arcgis-mcp-oauth:3324.
#
# Docker port mapping (host side)
# AUTH_PORT=3324
