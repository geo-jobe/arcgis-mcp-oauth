# Use "production" on server → loads config/production.toml
APP_ENV=local

DATABASE_URL=sqlite://./data/auth.db
PUBLIC_BASE_URL=http://localhost:3324

# Must match arcgis-mcp-rs INTERNAL_API_KEY
INTERNAL_API_KEY=change-me-in-production

# Docker: micro-auth creates the shared "arcgis-mcp" network. Start micro-auth before
# arcgis-mcp-rs so mcp-rs can reach this service at http://micro-auth:3324.
#
# Docker port mapping (host side)
# AUTH_PORT=3324
